# Copy to .env and fill in. .env is git-ignored and must stay that way.
# Keys live here and nowhere else: never in code, never in logs, never in git.
OPENAI_API_KEY=sk-...

# Needed only for deepseek-* models; they route to DeepSeek's endpoint by name.
DEEPSEEK_API_KEY=sk-...

# Additional providers (only fill those you use).
GLM_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
QWEN_API_KEY=
# Your Qwen provider's OpenAI-compatible base URL; no account endpoint is bundled.
QWEN_BASE_URL=
# Optional endpoint overrides: DEEPSEEK_BASE_URL, GLM_BASE_URL, GEMINI_BASE_URL.
